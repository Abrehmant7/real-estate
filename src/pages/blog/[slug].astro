---
import Icon from '../../components/Icon.astro';
import PageIntro from '../../components/PageIntro.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { posts, type Post } from '../../data/posts';
import { site } from '../../data/site';

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<SiteLayout title={`${post.title} | ${site.name}`} description={post.description}>
  <PageIntro eyebrow={post.category} title={post.title} description={post.description} />

  <article class="site-shell max-w-3xl py-12 md:py-16" aria-labelledby="page-title">
    <a class="mb-6 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-pine hover:underline" href="/blog/">
      <Icon name="arrow" class="size-4 rotate-180" /> All buyer guides
    </a>
    <img src={post.image} alt="" width="1672" height="941" class="aspect-[16/9] w-full rounded-2xl object-cover" />

    <div class="mt-10 grid gap-8">
      {post.sections.map(({ heading, body }) => (
        <section>
          <h2 class="text-2xl font-semibold tracking-tight">{heading}</h2>
          <p class="mt-3 leading-7 text-muted">{body}</p>
        </section>
      ))}
    </div>

    <a class="button button-pine mt-10" href="/projects/">Explore projects <Icon name="arrow" /></a>
  </article>
</SiteLayout>
