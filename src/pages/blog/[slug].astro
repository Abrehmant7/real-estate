---
import Icon from '../../components/Icon.astro';
import PageIntro from '../../components/PageIntro.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { homePosts } from '../../data/homePosts';
import { posts, type Post } from '../../data/posts';
import { site } from '../../data/site';

export function getStaticPaths() {
  return [...posts, ...homePosts].map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const fromHomepage = homePosts.some(({ slug }) => slug === post.slug);
---

<SiteLayout title={`${post.title} | ${site.name}`} description={post.description}>
  <PageIntro eyebrow={post.category} title={post.title} description={post.description} />

  <article class="site-shell max-w-3xl py-12 md:py-16" aria-labelledby="page-title">
    <a class="mb-6 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-pine hover:underline" href={fromHomepage ? '/#insights' : '/blog/'}>
      <Icon name="arrow" class="size-4 rotate-180" /> {fromHomepage ? 'More property insights' : 'All buyer guides'}
    </a>
    <img src={post.image} alt="" width="1672" height="941" class="aspect-[16/9] w-full rounded-2xl object-cover" />

    <div class="mt-10 grid gap-8">
      {post.sections.map(({ heading, body }) => (
        <section>
          <h2 class="text-2xl font-semibold tracking-tight">{heading}</h2>
          <p class="mt-3 leading-7 text-muted">{body}</p>
        </section>
      ))}
    </div>

    {post.sources?.length && (
      <section class="mt-10 border-t border-rule pt-6" aria-labelledby="article-sources">
        <h2 id="article-sources" class="font-semibold">Sources</h2>
        <ul class="mt-3 grid gap-2 text-sm leading-6 text-pine" role="list">
          {post.sources.map(({ label, href }) => <li><a class="underline underline-offset-4" href={href}>{label}</a></li>)}
        </ul>
      </section>
    )}

    <a class="button mt-10" href="/projects/">Explore projects <Icon name="arrow" /></a>
  </article>
</SiteLayout>
