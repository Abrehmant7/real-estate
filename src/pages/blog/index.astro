---
import Icon from '../../components/Icon.astro';
import PageIntro from '../../components/PageIntro.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { posts } from '../../data/posts';
import { site } from '../../data/site';
---

<SiteLayout title={`Blog | ${site.name}`} description="Read practical property guides on site visits, comparing developments, and preparing a project inquiry.">
  <PageIntro eyebrow="Blog" title="Property guides." description="Practical reading for buyers researching developments in Islamabad and Rawalpindi." />

  <section class="site-shell py-16 md:py-22" aria-labelledby="guides-title">
    <h2 id="guides-title" class="section-heading mb-8">Buyer guides</h2>
    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3" role="list">
      {posts.map((post) => (
        <li>
          <article class="group flex h-full flex-col overflow-hidden rounded-xl border border-rule bg-surface">
            <div class="aspect-[8/5] overflow-hidden bg-pine">
              <img src={post.image} alt="" loading="lazy" decoding="async" class="size-full object-cover motion-safe:transition-transform motion-safe:duration-500 motion-safe:group-hover:scale-[1.035]" />
            </div>
            <div class="flex grow flex-col p-6">
              <p class="text-xs font-semibold tracking-wide text-muted uppercase">{post.category}</p>
              <h3 class="mt-2 text-2xl leading-tight font-semibold tracking-tight">{post.title}</h3>
              <p class="mt-3 mb-5 text-sm leading-6 text-muted">{post.description}</p>
              <a href={`/blog/${post.slug}/`} aria-label={`Read ${post.title}`} class="mt-auto inline-flex min-h-11 w-fit items-center gap-2 text-sm font-semibold text-pine hover:underline">Read guide <Icon name="arrow" /></a>
            </div>
          </article>
        </li>
      ))}
    </ul>
  </section>
</SiteLayout>
