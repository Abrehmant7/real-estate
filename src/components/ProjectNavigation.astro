---
import Icon from './Icon.astro';
import { projectNavigation } from '../data/projects';

interface Props {
  mobile?: boolean;
}

const { mobile = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/?$/, '/');
const isProjects = path.startsWith('/projects/');
---

<details class="group/projects relative" data-project-nav>
  <summary class:list={[
    'flex min-h-11 cursor-pointer list-none items-center gap-1.5 rounded transition-colors hover:text-sand [&::-webkit-details-marker]:hidden',
    mobile && 'px-2 py-3',
    isProjects && 'font-semibold text-paper underline decoration-sand decoration-2 underline-offset-8',
  ]}>
    Projects <Icon name="chevron" class="size-3.5 text-sand motion-safe:transition-transform group-open/projects:rotate-180" />
  </summary>
  <ul class:list={[
    'rounded-xl border border-rule bg-surface p-2 text-sm text-ink',
    mobile ? 'mx-2 mb-2' : 'absolute top-full left-1/2 z-10 w-60 -translate-x-1/2 shadow-xl',
  ]}>
    {projectNavigation.map(({ label, href }) => (
      <li>
        <a class="block rounded-lg px-3 py-2.5 hover:bg-panel aria-[current=page]:bg-panel aria-[current=page]:font-semibold" href={href} aria-current={href === path ? 'page' : undefined}>{label}</a>
      </li>
    ))}
    <li class="mt-1 border-t border-rule pt-1">
      <a class="flex items-center justify-between gap-2 rounded-lg px-3 py-2.5 font-semibold hover:bg-panel" href="/projects/" aria-current={path === '/projects/' ? 'page' : undefined}>
        View all projects <Icon name="arrow" />
      </a>
    </li>
  </ul>
</details>

