---
import { site } from '../data/site';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<a href="/" class="inline-flex min-h-11 w-fit items-center" aria-label={`${site.name} home`}>
  <img src="/logos/rove-estates-on-dark.svg" alt="" width="1807" height="601" class:list={['h-auto', compact ? 'w-32 sm:w-36' : 'w-36 sm:w-40']} />
</a>
