---
import Icon from './Icon.astro';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  onHomepage?: boolean;
}

const { project, onHomepage = false } = Astro.props;
const inquiryHref = onHomepage ? '#inquiry' : `/contact/?project=${project.slug}#inquiry`;
---

<article class="group flex h-full flex-col overflow-hidden rounded-xl border border-rule bg-surface">
  <div class="relative aspect-[8/5] overflow-hidden bg-pine">
    <img src={project.image} alt={project.imageAlt} loading="lazy" decoding="async" class="absolute inset-0 size-full object-cover motion-safe:transition-transform motion-safe:duration-500 motion-safe:group-hover:scale-[1.035]" />
    {project.illustrative && (
      <span class="absolute bottom-3 left-3 rounded-full bg-deep-pine/90 px-2.5 py-1 text-xs text-white">Illustrative image</span>
    )}
  </div>
  <div class="flex grow flex-col px-6 pt-5 pb-6">
    <p class="inline-flex items-center gap-1.5 text-xs font-medium text-muted"><Icon name="pin" class="size-3.5 shrink-0" />{project.location}</p>
    <h3 class="mt-2 text-[1.7rem] leading-tight font-semibold tracking-[-0.045em]">{project.name}</h3>
    <p class="mt-3 mb-5 text-sm leading-6 text-muted">{project.summary}</p>
    <a class="mt-auto inline-flex min-h-11 w-fit items-center gap-2 text-sm font-semibold text-pine hover:underline" href={inquiryHref} data-inquiry-project={onHomepage ? project.name : undefined} aria-label={`Ask about ${project.name}`}>
      Ask about this project <Icon name="diagonal" />
    </a>
  </div>
</article>
