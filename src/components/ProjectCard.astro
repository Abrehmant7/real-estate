---
import Icon from './Icon.astro';
import { projectInquiryHref, type Project } from '../data/projects';

interface Props {
  project: Project;
  onHomepage?: boolean;
  detailsHref?: string;
}

const { project, onHomepage = false, detailsHref } = Astro.props;
const href = detailsHref ?? (onHomepage ? '#inquiry' : projectInquiryHref(project.slug));
const imageCaption = project.illustrative ? 'Illustrative image' : project.imageCaption;
---

<article class="group flex h-full flex-col overflow-hidden rounded-xl border border-rule bg-surface">
  <div class:list={['relative overflow-hidden bg-pine', onHomepage ? 'aspect-[2/1] max-h-44' : 'aspect-[8/5]']}>
    <img src={project.image} alt={project.imageAlt} loading="lazy" decoding="async" class="absolute inset-0 size-full object-cover motion-safe:transition-transform motion-safe:duration-500 motion-safe:group-hover:scale-[1.035]" />
    {imageCaption && (
      <span class="absolute bottom-3 left-3 rounded-full bg-deep-pine/90 px-2.5 py-1 text-xs text-white">{imageCaption}</span>
    )}
  </div>
  <div class:list={['flex grow flex-col', onHomepage ? 'px-5 pt-4 pb-3' : 'px-6 pt-5 pb-6']}>
    <p class="inline-flex items-center gap-1.5 text-xs font-medium text-muted"><Icon name="pin" class="size-3.5 shrink-0" />{project.location}</p>
    <h3 class:list={['mt-2 leading-tight font-semibold tracking-[-0.045em]', onHomepage ? 'text-2xl' : 'text-[1.7rem]']}>{project.name}</h3>
    <p class:list={['text-sm text-muted', onHomepage ? 'mt-2 mb-2 leading-5' : 'mt-3 mb-5 leading-6']}>{project.summary}</p>
    <a class="mt-auto inline-flex min-h-11 w-fit items-center gap-2 text-sm font-semibold text-pine hover:underline" href={href} data-inquiry-project={onHomepage && !detailsHref ? project.name : undefined} aria-label={`${detailsHref ? 'View' : 'Ask about'} ${project.name}`}>
      {detailsHref ? 'View project' : 'Ask about this project'} <Icon name={detailsHref ? 'arrow' : 'diagonal'} />
    </a>
  </div>
</article>
