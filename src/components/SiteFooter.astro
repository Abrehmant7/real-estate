---
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import { navigation, site } from '../data/site';
---

<footer class="bg-deep-pine text-paper">
  <div class="site-shell grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-[1.45fr_0.75fr_1fr] lg:gap-16 lg:py-16">
    <div class="sm:col-span-2 lg:col-span-1">
      <Brand light />
      <p class="mt-5 max-w-[18rem] text-sm leading-6 text-white/70">Local property guidance for buyers and investors in Islamabad.</p>
    </div>

    <nav aria-label="Footer navigation">
      <p class="mb-4 text-[0.68rem] font-semibold tracking-[0.16em] text-sand uppercase">Explore</p>
      <ul class="grid gap-3 text-sm text-white/80">
        {navigation.map(({ label, href }) => <li><a class="hover:text-white hover:underline" href={href}>{label}</a></li>)}
      </ul>
    </nav>

    <div>
      <p class="mb-4 text-[0.68rem] font-semibold tracking-[0.16em] text-sand uppercase">Contact</p>
      <address class="grid gap-3 text-sm leading-6 text-white/80 not-italic">
        <span>{site.address[0]}<br />{site.address[1]}</span>
        <a class="w-fit break-all hover:text-white hover:underline" href={`mailto:${site.email}`}>{site.email}</a>
      </address>
    </div>
  </div>

  <div class="border-t border-white/12">
    <div class="site-shell flex flex-wrap items-center justify-between gap-4 py-5 text-xs text-white/70">
      <p>© {new Date().getFullYear()} {site.name}</p>
      <a class="inline-flex items-center gap-1.5 hover:text-white" href="#top">Back to top <Icon name="diagonal" class="size-3" /></a>
    </div>
  </div>
</footer>
